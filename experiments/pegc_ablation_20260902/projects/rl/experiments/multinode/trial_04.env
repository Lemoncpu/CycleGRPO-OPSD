# Two-node H20 trial. Edit values here; the cluster controller supplies Ray topology.
BASE_DIR="${BASE_DIR:-/volume/ybo/xyc}"
REPO_DIR="${REPO_DIR:-${BASE_DIR}/CycleGRPO-OPSD}"
ENV_DIR="${ENV_DIR:-${BASE_DIR}/envs/cyclegrpo}"
MODEL_PATH="${MODEL_PATH:-${BASE_DIR}/Qwen3-VL-4B-SAMTok}"
TRAIN_DATA="${TRAIN_DATA:-${BASE_DIR}/datasets/cyclegrpo_20k_raw_seed20260820/cyclegrpo_20k_40_20_25_10_5_seed20260820.parquet}"
VAL_DATA="${VAL_DATA:-${TRAIN_DATA}}"
DIRECT_TRAIN_DATA="${DIRECT_TRAIN_DATA:-${BASE_DIR}/datasets/direct_refcoco30k_disjoint_cycle20k/refcoco_train_30k_disjoint_cycle20k_seed20260823.parquet}"
DIRECT_NO_TARGET_TRAIN_DATA="${DIRECT_NO_TARGET_TRAIN_DATA:-${BASE_DIR}/datasets/direct_refcoco30k_notarget10k_disjoint_cycle20k/grefcoco_train_0pos_10000notarget_disjoint_cycle20k_and_refcoco_seed20260823.parquet}"
CAPTION_QA_TRAIN_DATA="${CAPTION_QA_TRAIN_DATA:-${BASE_DIR}/datasets/dlc_qa/dlc_qa_10000.parquet}"
CAPTION_QA_JSONL="${CAPTION_QA_JSONL:-${BASE_DIR}/datasets/dlc_qa/dam_caption_qa_10000.jsonl}"
# Judge is disabled for this pure 20k CycleGRPO trial. If enabled for a later
# auxiliary-task trial, the controller can start one local judge on GPU 7.
LOCAL_JUDGE_ENABLED=false
LOCAL_JUDGE_CUDA_DEVICE=7
LOCAL_JUDGE_MODEL_PATH="${LOCAL_JUDGE_MODEL_PATH:-${BASE_DIR}/models/Meta-Llama-3.1-8B-Instruct-hf-v2}"
LOCAL_JUDGE_SERVED_MODEL_NAME="llama3.1-8b"
LOCAL_JUDGE_API_KEY="sk-abc123"
LOCAL_JUDGE_HOST="0.0.0.0"
LOCAL_JUDGE_PORT=8007
LOCAL_JUDGE_GPU_MEMORY_UTILIZATION=0.85
CAPTION_QA_JUDGE_BASE_URL="${CAPTION_QA_JUDGE_BASE_URL:-}"
CAPTION_QA_JUDGE_MODEL="${CAPTION_QA_JUDGE_MODEL:-llama3.1-8b}"
CAPTION_QA_JUDGE_API_KEY="${CAPTION_QA_JUDGE_API_KEY:-${LOCAL_JUDGE_API_KEY}}"

RUN_NAME="cyclegrpo20k_multinode_refcoco_union"
RUN_ROOT="${REPO_DIR}/logs/${RUN_NAME}"
NUM_GPUS=8
ROLLOUT_BATCH_SIZE=128
ACTOR_GLOBAL_BATCH_SIZE=128
CAPTION_ROLLOUTS=6
LOCALIZATION_ROLLOUTS=6
TOTAL_EPOCHS=1
MAX_STEPS=156
SAVE_FREQ=5
SAVE_LIMIT=2
RESUME=false
TRAINER_LOGGERS='["file"]'

OPSD_ENABLED=true
PIXEL_IOU_ENABLED=true
SEGMENTATION_MAX_RESPONSE_TOKENS=256
MASK_DECODE_MODE=union
LOCALIZATION_PROMPT_MODE=refcoco
CYCLE_PROMPT_MODE=current
NO_TARGET_REWARD_MODE=pixel_empty
ROUTING_ENABLED=true
PRESERVE_ORIGINAL_GRPO=true
EMA_TEACHER_ENABLED=true
TEACHER_ANALYSIS_ENABLED=true
TEACHER_EMA_DECAY=1.0
TEACHER_CONFIDENCE_ENABLED=true
CAPTION_SAFETY_ENABLED=true
CAPTION_SAFETY_FORCE_REGENERATE=true
CAPTION_BLOCK_SPECIAL_TOKEN_VOCAB=true
CAPTION_ANCHOR_KL_COEF=0.05
CAPTION_ANCHOR_KL_ALL_SAFE_ROUTES=true
SEGMENTATION_ANCHOR_KL_COEF=0.05
ASYMMETRIC_GRADIENT_PROJECTION=false

DIRECT_GROUNDING_ENABLED=false
DIRECT_BATCH_SIZE=256
DIRECT_GROUNDING_ROLLOUTS=6
DIRECT_GROUNDING_LOSS_WEIGHT=0.5
DIRECT_GROUNDING_WARMUP_START_STEP=10
DIRECT_GROUNDING_WARMUP_END_STEP=30
DIRECT_GROUNDING_INCLUDE_POSITIVE_SOURCES=false
DIRECT_GROUNDING_INCLUDE_NO_TARGET=false
DIRECT_GROUNDING_INCLUDE_LABEL_SOURCES=false
DIRECT_MASK_CE_ENABLED=false
DIRECT_MASK_CE_LOSS_WEIGHT=0.02
DIRECT_MASK_CE_INCLUDE_NO_TARGET=false
SUPERVISED_CAPTION_QA_ENABLED=false
CAPTION_QA_BATCH_SIZE=64
CAPTION_QA_MAX_CONCURRENCY=16
CAPTION_QA_TIMEOUT_SECONDS=60
CAPTION_QA_REWARD_WEIGHT=1.0
CAPTION_QA_LOSS_WEIGHT=1.0
THREE_STREAM_2_4_1_ENABLED=false
MULTITASK_GRADIENT_DIAGNOSTICS_ENABLED=false
DIRECT_MASK_CE_RECORD_BASE_GRADIENT_COSINE=false
